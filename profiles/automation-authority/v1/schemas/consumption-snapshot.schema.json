{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opencoven.dev/automation-authority/v1/consumption-snapshot.schema.json",
  "title": "AutomationConsumptionSnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "recorded_at",
    "store_revision",
    "request_adoptions",
    "decision_consumptions",
    "approval_heads",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "opencoven.automation-consumption-snapshot/v1"
    },
    "snapshot_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "store_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "request_adoptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_digest", "nonce", "adoption_key"],
        "properties": {
          "request_digest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "nonce": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "adoption_key": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "decision_consumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/digest"
      }
    },
    "approval_heads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approval_id", "head_event_digest", "usage_count"],
        "properties": {
          "approval_id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "head_event_digest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "usage_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "integrity": {
      "$ref": "common.schema.json#/$defs/integrity"
    }
  }
}
