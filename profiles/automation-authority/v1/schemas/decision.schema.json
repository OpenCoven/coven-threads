{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opencoven.dev/automation-authority/v1/decision.schema.json",
  "title": "AutomationAuthorizationDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "request_id",
    "request_digest",
    "correlation",
    "bindings",
    "outcome",
    "granted_capabilities",
    "denied_capabilities",
    "degraded_capabilities",
    "scopes",
    "validity",
    "approval_requirement",
    "versions",
    "reason_codes",
    "producer",
    "issued_at",
    "recorded_at",
    "replay",
    "privacy",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "opencoven.automation-authorization-decision/v1"
    },
    "decision_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "request_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence_id", "run_id", "attempt", "fence_generation"],
      "properties": {
        "occurrence_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "run_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fence_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "familiar_id",
        "familiar_embodiment_digest",
        "automation_id",
        "definition_revision",
        "definition_digest",
        "action_digest",
        "project_id",
        "workspace_id",
        "runtime_id",
        "runtime_descriptor_digest",
        "runtime_capabilities",
        "previous_approval_digest"
      ],
      "properties": {
        "principal_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "familiar_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "familiar_embodiment_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "automation_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "definition_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "definition_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "action_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "project_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "workspace_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "runtime_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "runtime_descriptor_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "runtime_capabilities": {
          "$ref": "common.schema.json#/$defs/capabilities"
        },
        "previous_approval_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/digest"
            }
          ]
        }
      }
    },
    "outcome": {
      "enum": ["permit", "requires_approval", "degrade_to_proposal", "reject"]
    },
    "granted_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/capability"
      }
    },
    "denied_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "reason_code"],
        "properties": {
          "capability": {
            "$ref": "common.schema.json#/$defs/capability"
          },
          "reason_code": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "degraded_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/capability"
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/scope"
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not_before", "not_after"],
      "properties": {
        "not_before": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "not_after": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "approval_requirement": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "recurring_allowed"],
          "properties": {
            "profile": {
              "enum": ["human_per_run", "protected_owner_per_run"]
            },
            "recurring_allowed": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "policy", "policy_digest", "manifest", "manifest_digest"],
      "properties": {
        "profile": {
          "const": "1.0.0"
        },
        "policy": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "policy_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "manifest": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "manifest_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "verifier_profile"],
      "properties": {
        "id": {
          "const": "coven-threads"
        },
        "verifier_profile": {
          "const": "automation-authority/1.0.0"
        }
      }
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatches", "consumption_required"],
      "properties": {
        "dispatches": {
          "const": 1
        },
        "consumption_required": {
          "type": "boolean"
        }
      }
    },
    "privacy": {
      "$ref": "common.schema.json#/$defs/privacy"
    },
    "integrity": {
      "$ref": "common.schema.json#/$defs/integrity"
    }
  }
}
